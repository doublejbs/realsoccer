# 로컬 개발용 템플릿 — 실제 값은 .env.local에 복사해서 채우기.
# 절대 실제 키를 이 파일에 넣어 커밋하지 말 것.

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Feature flags
USE_MOCK=false

# Supabase (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database (Supabase pooler — Project Settings → Database → Connection string)
DATABASE_URL=
DIRECT_URL=

# football-data.org (https://www.football-data.org/client/home)
FOOTBALL_DATA_API_KEY=

# Anthropic (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Cron (Vercel Cron의 Authorization 검증용 — 아무 긴 랜덤 문자열)
CRON_SECRET=
