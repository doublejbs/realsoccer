generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                   String           @id @db.Uuid
  email                String           @unique
  displayName          String?          @map("display_name")
  avatarUrl            String?          @map("avatar_url")
  authProvider         String           @default("google") @map("auth_provider")
  authProviderUserId   String?          @map("auth_provider_user_id")
  createdAt            DateTime         @default(now()) @map("created_at")

  preferences          UserPreference?

  @@map("users")
}

model UserPreference {
  userId           String   @id @map("user_id") @db.Uuid
  favoriteLeagues  String[] @default([]) @map("favorite_leagues")
  favoriteTeams    String[] @default([]) @map("favorite_teams")
  favoriteStyles   String[] @default([]) @map("favorite_styles")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

// 매치 데이터는 cron이 football-data.org에서 주기 동기화해 DB에 캐시.
// 유저 요청은 DB만 읽고 외부 API를 호출하지 않는다.
model Match {
  id         String   @id                  // external(football-data.org) match id
  leagueCode String   @map("league_code")
  kickoffAt  DateTime @map("kickoff_at")
  status     String
  homeScore  Int?     @map("home_score")
  awayScore  Int?     @map("away_score")
  homeTeam   Json     @map("home_team")    // TeamDTO JSON
  awayTeam   Json     @map("away_team")
  importance Int
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([kickoffAt])
  @@index([status])
  @@map("matches")
}

// match_id는 외부 매치 ID 문자열 (football-data.org 숫자 ID 또는 mock ID).
model MatchContent {
  id        String   @id @default(cuid())
  matchId   String   @map("match_id")
  kind      String   // 'reason' | 'watch_points' | 'summary'
  content   Json
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([matchId, kind])
  @@map("match_contents")
}
